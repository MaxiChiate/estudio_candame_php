{% extends 'layout/base.html.twig' %}
{% block content %}
<main>
<section class="sectionPage surface centered errorPage">
    <div class="sectionHead">
        <p class="eyebrow">Error {{ statusCode }}</p>
        <h1>{{ errorTitle }}</h1>
        <p class="lede">{{ errorMessage }}</p>
        <div class="heroActions">
            <a class="btn" href="{{ basePath }}/">Volver al inicio</a>
        </div>
    </div>
</section>
</main>
{% endblock %}
