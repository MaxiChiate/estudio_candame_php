{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="adminTitulo">
    <h1>Tr&aacute;mites</h1>
    <a class="adminBtn" href="{{ basePath }}/admin/tramites/nuevo">Nuevo tr&aacute;mite</a>
</div>

{% if filas is empty %}
    <p class="adminVacio">Todav&iacute;a no hay tr&aacute;mites cargados.</p>
{% else %}
<table class="adminTabla">
    <thead>
        <tr>
            <th>C&oacute;digo</th>
            <th>Denominaci&oacute;n</th>
            <th>Etapa</th>
            <th>Actualizado</th>
            <th class="adminColAccion">Avanzar</th>
        </tr>
    </thead>
    <tbody>
        {% for fila in filas %}
            <tr{% if fila.tramite.observado %} class="is-observado"{% endif %}>
                <td><a href="{{ basePath }}/admin/tramites/{{ fila.tramite.id }}">{{ fila.tramite.codigo }}</a></td>
                <td>
                    {{ fila.tramite.denominacion }}
                    {% if fila.tramite.observado %}<span class="adminChip">observado</span>{% endif %}
                </td>
                <td>{{ fila.etapaLabel }}</td>
                <td>{{ fila.tramite.actualizadoEl|date('d/m/Y') }}</td>
                <td class="adminColAccion">
                    {% if fila.siguiente %}
                        {# Un click: sin etapa explicita, avanzar() toma la siguiente. #}
                        <form method="post" action="{{ basePath }}/admin/tramites/{{ fila.tramite.id }}/avanzar">
                            <input type="hidden" name="_csrf" value="{{ csrf }}"/>
                            <input type="hidden" name="volver" value="listado"/>
                            <button type="submit" class="adminBtn adminBtnChico">&rarr; {{ fila.siguienteLabel }}</button>
                        </form>
                    {% else %}
                        <span class="adminTenue">completado</span>
                    {% endif %}
                </td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endblock %}
