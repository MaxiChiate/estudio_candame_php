{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="adminTitulo">
    <h1>Tr&aacute;mites</h1>
    <a class="adminBtn" href="{{ basePath }}/admin/tramites/nuevo">Nuevo tr&aacute;mite</a>
</div>

{% if filas is empty %}
    <p class="adminVacio">Todav&iacute;a no hay tr&aacute;mites cargados.</p>
{% else %}
<table class="adminTabla">
    <thead>
        <tr>
            <th>C&oacute;digo</th>
            <th>Denominaci&oacute;n</th>
            <th>Tipo</th>
            <th>Etapa</th>
            <th>Actualizado</th>
        </tr>
    </thead>
    <tbody>
        {% for fila in filas %}
            {# Toda la fila lleva al detalle con <a> reales (click derecho, pestana nueva),
               uno por celda de datos porque un <a> no puede envolver un <tr>. Solo el
               primero es foco/lector de pantalla: los demas son el mismo destino repetido.
               No hay boton de avanzar aca a proposito: se confundia con el de entrar al
               tramite. Avanzar se hace desde el detalle. #}
            {% set urlDetalle = basePath ~ '/admin/tramites/' ~ fila.tramite.id %}
            <tr class="adminFilaLink{% if fila.tramite.observado %} is-observado{% endif %}">
                <td><a href="{{ urlDetalle }}">{{ fila.tramite.referencia }}</a></td>
                <td>
                    <a href="{{ urlDetalle }}" tabindex="-1" aria-hidden="true">
                        {{ fila.tramite.denominacion }}
                        {% if fila.tramite.observado %}<span class="adminChip">observado</span>{% endif %}
                    </a>
                </td>
                <td><a href="{{ urlDetalle }}" tabindex="-1" aria-hidden="true">{{ fila.flujoNombre }}</a></td>
                <td><a href="{{ urlDetalle }}" tabindex="-1" aria-hidden="true">{{ fila.etapaLabel }}</a></td>
                <td><a href="{{ urlDetalle }}" tabindex="-1" aria-hidden="true">{{ fila.tramite.actualizadoEl|date('d/m/Y') }}</a></td>
            </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% endblock %}
