<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="robots" content="noindex,nofollow"/>
    <title>{{ pageTitle|default('Panel') }} - Estudio Candame</title>
    <link rel="icon" href="{{ basePath }}/favicon.ico" sizes="any"/>
    <link rel="stylesheet" href="{{ basePath }}/css/admin.css"/>
</head>
<body>
<header class="adminHeader">
    <a class="adminMarca" href="{{ basePath }}/admin/tramites">Estudio Candame &middot; Panel</a>
    <a class="adminLink" href="{{ basePath }}/" target="_blank" rel="noopener">Ver el sitio</a>
</header>

<main class="adminMain">
    {% if flash is defined and flash %}
        <p class="adminFlash is-{{ flash.tipo }}" role="status">{{ flash.mensaje }}</p>
    {% endif %}
    {% block content %}{% endblock %}
</main>
<script>
    // Un form del panel se manda una sola vez: un doble click publicaba la misma novedad
    // dos veces o avanzaba dos etapas. Escucha en document, asi corre DESPUES de los
    // handlers del form: si un confirm() cancelo el envio, no se bloquea nada. Los
    // botones se deshabilitan recien en el tick siguiente, porque un boton deshabilitado
    // antes de armar el envio no manda su name/value (los de "Avanzar a" llevan la etapa).
    (function () {
        document.addEventListener('submit', function (e) {
            var form = e.target;
            if (form.dataset.enviando) { e.preventDefault(); return; }
            if (e.defaultPrevented) { return; }
            form.dataset.enviando = '1';
            setTimeout(function () {
                form.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = true; });
            }, 0);
        });
        // Volver con el boton "atras" restaura la pagina desde el cache con los botones
        // deshabilitados: se rehabilitan.
        window.addEventListener('pageshow', function (e) {
            if (!e.persisted) { return; }
            document.querySelectorAll('form[data-enviando]').forEach(function (form) {
                delete form.dataset.enviando;
                form.querySelectorAll('button[type="submit"]').forEach(function (b) { b.disabled = false; });
            });
        });
    })();
</script>
</body>
</html>
