{% extends 'admin/layout.html.twig' %}
{% block content %}
<div class="adminTitulo">
    <h1>{{ tramite.referencia }}</h1>
    <a class="adminLink" href="{{ basePath }}/admin/tramites">Volver al listado</a>
</div>

<p class="adminSubtitulo">
    {{ tramite.denominacion }}.
    Etapa actual: <strong>{{ etapaLabel }}</strong>{% if tramite.observado %} &middot; <span class="adminChip">observado</span>{% endif %}
</p>
{# Solo lectura: el tipo de tramite se eligio al crear y no se puede cambiar -- no hay
   ninguna ruta que lo modifique. #}
<p class="adminSubtitulo adminTenue">Tipo de tr&aacute;mite: {{ flujoNombre }}</p>

{# Tres bloques separados a proposito: publicar algo al cliente, mover la etapa, y lo
   interno. Antes eran un solo form, y para publicar una nota sin avanzar habia que
   "registrar" la etapa en curso -- el cliente lo veia como un cambio de etapa. #}
<section class="adminSeccion" id="novedad">
    <div class="adminSeccionCabecera">
        <h2>Publicar novedad</h2>
        {% if enlaceCliente %}
            {# El enlace real del cliente: abrirlo suma un acceso en la tabla de enlaces. #}
            <a class="adminLink" href="{{ enlaceCliente }}" target="_blank" rel="noopener noreferrer">Ver como cliente &#8599;</a>
        {% else %}
            <span class="adminTenue">Para verlo como el cliente, <a class="adminLink" href="#enlaces">emit&iacute; un enlace</a>.</span>
        {% endif %}
    </div>
    <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/novedades" class="adminForm">
        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
        <label for="novedad_texto">Mensaje para el cliente</label>
        <textarea id="novedad_texto" name="texto" rows="3" required maxlength="{{ maxNota }}"></textarea>
        <p class="adminAyuda">No cambia la etapa. El cliente lo ve en &laquo;Novedades&raquo;, con la fecha de hoy.</p>
        {% if mailClienteEnabled %}
            <label class="adminCheck"><input type="checkbox" name="avisar_cliente" value="1"/> Avisar al cliente por mail</label>
        {% endif %}
        <button type="submit" class="adminBtn">Publicar</button>
    </form>
</section>

<section class="adminSeccion" id="etapa">
    <h2>Etapa</h2>

    {% if etapaActualFueraDeFlujo %}
        {# Datos de antes de que el panel dejara de ofrecer etapas de otros tipos de
           tramite. No se rompe nada: se muestra la actual y se puede volver al flujo. #}
        <p class="adminAviso">
            La etapa actual, <strong>{{ etapaLabel }}</strong>, no es de {{ flujoNombre }}.
            Eleg&iacute; una etapa de este tr&aacute;mite en &laquo;Cambiar a otra etapa&raquo;.
        </p>
    {% endif %}

    <ol class="adminPasos">
        {% for paso in pasos %}
            <li class="adminPaso is-{{ paso.estado }}"{% if paso.estado == 'actual' %} aria-current="step"{% endif %}>{{ paso.label }}</li>
        {% endfor %}
    </ol>

    {# El caso del 90%: un click. En Vista contestada son dos botones, porque el
       inspector puede despachar otra vista en vez de dar por terminado el tramite. El
       mensaje opcional esta DENTRO del mismo form y de la misma caja que los botones:
       sale con el que se toque. #}
    {% if siguientes is not empty %}
        <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/avanzar" class="adminForm adminCajaAvance">
            <input type="hidden" name="_csrf" value="{{ csrf }}"/>
            <details class="adminMensajeAvance">
                <summary>+ Agregar mensaje para el cliente a este cambio</summary>
                <label for="nota_publica">Mensaje para el cliente <span class="adminTenue">(sale junto con el cambio de etapa)</span></label>
                <textarea id="nota_publica" name="nota_publica" rows="3" maxlength="{{ maxNota }}"></textarea>
            </details>
            <div class="adminAccionesEtapa">
                {% for siguiente in siguientes %}
                    <button type="submit" name="etapa" value="{{ siguiente.valor }}" class="adminBtn">Avanzar a: {{ siguiente.label }}</button>
                {% endfor %}
            </div>
        </form>
    {% elseif not etapaActualFueraDeFlujo %}
        <p class="adminVacio">Es la &uacute;ltima etapa de este tr&aacute;mite.</p>
    {% endif %}

    {# Escape: saltear etapas o volver atras, siempre dentro del flujo. La actual va
       deshabilitada: ir a la misma etapa es "Publicar novedad". #}
    <details class="adminOtraEtapa"{% if etapaActualFueraDeFlujo %} open{% endif %}>
        <summary>Cambiar a otra etapa&hellip;</summary>
        <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/avanzar" class="adminForm"
              data-confirmar-retroceso data-posicion-actual="{{ posicionActual }}">
            <input type="hidden" name="_csrf" value="{{ csrf }}"/>
            <label for="etapa_destino">Etapa</label>
            <select id="etapa_destino" name="etapa" required>
                <option value="" selected disabled>Eleg&iacute; la etapa&hellip;</option>
                {% for etapa in etapasDelFlujo %}
                    <option value="{{ etapa.valor }}" data-posicion="{{ loop.index0 }}"{% if etapa.actual %} disabled{% endif %}>
                        {{- etapa.label }}{% if etapa.actual %} (actual){% endif -%}
                    </option>
                {% endfor %}
            </select>
            <button type="submit" class="adminBtn adminBtnInverso">Cambiar de etapa</button>
        </form>
    </details>
</section>

<section class="adminSeccion adminSeccionInterna" id="nota-interna">
    <h2>Nota interna &#128274; <span class="adminTenue">(solo panel)</span></h2>
    <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/notas-internas" class="adminForm">
        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
        <label for="nota_interna_texto">Nota</label>
        <textarea id="nota_interna_texto" name="texto" rows="2" required maxlength="{{ maxNota }}"></textarea>
        <p class="adminAyuda">Nunca sale del panel: no cambia la etapa ni le publica nada al cliente.</p>
        <button type="submit" class="adminBtn adminBtnInverso">Guardar nota interna</button>
    </form>
</section>

<section class="adminSeccion">
    <h2>Observaci&oacute;n</h2>
    <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/observacion" class="adminForm">
        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
        <p class="adminAyuda">
            Para observaciones de fuera de IGJ: escriban&iacute;a que rechaza algo, documentaci&oacute;n incompleta.
            Para vistas de IGJ us&aacute; las etapas Tr&aacute;mite con vista / Vista contestada.
        </p>
        <label for="nota_observacion">Nota de la observaci&oacute;n <span class="adminTenue">(la ve el cliente)</span></label>
        <textarea id="nota_observacion" name="nota_observacion" rows="2">{{ tramite.notaObservacion }}</textarea>
        <button type="submit" class="adminBtn">
            {% if tramite.observado %}Levantar la observaci&oacute;n{% else %}Marcar como observado{% endif %}
        </button>
    </form>
</section>

<section class="adminSeccion">
    <div class="adminSeccionCabecera">
        <h2>Historial</h2>
        <a class="adminBtn adminBtnInverso adminBtnChico" href="{{ basePath }}/admin/tramites/{{ tramite.id }}/historial">Editar historial</a>
    </div>
    {% if historial is empty %}
        <p class="adminVacio">Sin eventos.</p>
    {% else %}
        {# Cambios de etapa, novedades y notas internas, mas recientes primero. Novedades
           y notas llevan la etapa en la que estaba el tramite, como referencia. #}
        <ul class="adminEventos">
            {% for item in historial %}
                <li class="is-{{ item.tipo }}">
                    <p class="adminEventoCabecera">
                        {{ item.fecha|date('d/m/Y') }} &middot;
                        {% if item.tipo == 'etapa' %}
                            {{ item.etapa }}
                        {% elseif item.tipo == 'novedad' %}
                            Novedad para el cliente <span class="adminTenue">(en {{ item.etapa }})</span>
                        {% else %}
                            Nota interna &#128274; <span class="adminTenue">(en {{ item.etapa }})</span>
                        {% endif %}
                    </p>
                    {% if item.notaPublica %}<p class="adminNotaPublica">{{ item.notaPublica|e|nl2br }}</p>{% endif %}
                    {% if item.notaInterna %}<p class="adminNotaInterna">{% if item.tipo == 'etapa' %}Interna: {% endif %}{{ item.notaInterna|e|nl2br }}</p>{% endif %}
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</section>

<section class="adminSeccion" id="enlaces">
    <h2>Enlaces de acceso</h2>

    <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/accesos" class="adminForm adminFormInline">
        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
        <label for="etiqueta">Para qui&eacute;n</label>
        <input type="text" id="etiqueta" name="etiqueta" maxlength="120" required placeholder="cliente Juan P&eacute;rez"/>
        <button type="submit" class="adminBtn">Emitir enlace</button>
    </form>

    {% if tokenNuevo and not tokenNuevoRecuperable %}
        {# Solo sin SEGUIMIENTO_TOKEN_KEY: el token no quedo guardado y esta es la unica
           vez que existe en claro. Con la clave no hace falta aviso, se copia desde la
           tabla. #}
        <div class="adminTokenNuevo">
            <p class="adminTokenTitulo">Enlace generado &mdash; copialo ahora</p>
            <p class="adminTokenAviso">Es la <strong>&uacute;nica vez</strong> que se muestra: no qued&oacute; guardado para volver a copiarlo.</p>
            <div class="adminTokenFila">
                <input type="text" id="tokenNuevo" readonly value="{{ appUrl }}{{ basePath }}/seguimiento/{{ tokenNuevo }}"/>
                <button type="button" class="adminBtn" data-copiar="{{ appUrl }}{{ basePath }}/seguimiento/{{ tokenNuevo }}">Copiar</button>
            </div>
        </div>
    {% endif %}

    {% if accesos is empty %}
        <p class="adminVacio">Sin enlaces emitidos.</p>
    {% else %}
        <table class="adminTabla">
            <thead>
                <tr><th>Etiqueta</th><th>Emitido</th><th>&Uacute;ltimo acceso</th><th>Accesos</th><th>Estado</th></tr>
            </thead>
            <tbody>
                {% for acceso in accesos %}
                    <tr{% if acceso.estaRevocado %} class="is-revocado"{% endif %}>
                        <td>{{ acceso.etiqueta }}</td>
                        <td>{{ acceso.creadoEl|date('d/m/Y') }}</td>
                        <td>{% if acceso.ultimoAccesoEl %}{{ acceso.ultimoAccesoEl|date('d/m/Y H:i') }}{% else %}<span class="adminTenue">nunca</span>{% endif %}</td>
                        <td>{{ acceso.accesos }}</td>
                        <td>
                            {% if acceso.estaRevocado %}
                                <span class="adminTenue">revocado el {{ acceso.revocadoEl|date('d/m/Y') }}</span>
                            {% else %}
                                <div class="adminAccionesAcceso">
                                    {% if acceso.sePuedeCopiar %}
                                        <button type="button" class="adminBtn" data-copiar="{{ appUrl }}{{ basePath }}/seguimiento/{{ acceso.token }}">Copiar</button>
                                    {% else %}
                                        {# Emitido antes de que se guardara el token, o sin
                                           SEGUIMIENTO_TOKEN_KEY: anda, pero no se puede copiar. #}
                                        <span class="adminTenue" title="Este enlace se emiti&oacute; sin guardar una copia. Sigue funcionando; si hace falta mandarlo de nuevo, emit&iacute; uno nuevo.">sin copia</span>
                                    {% endif %}
                                    <form method="post" action="{{ basePath }}/admin/accesos/{{ acceso.id }}/revocar">
                                        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
                                        <button type="submit" class="adminBtnTexto">Revocar</button>
                                    </form>
                                </div>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}
</section>

{# Al final y separado del resto a proposito: es lo unico del panel que no tiene vuelta
   atras. El boton de la zona solo abre el dialogo; el que borra de verdad es el de
   adentro. Sin JS el dialogo no abre y no se borra nada -- falla hacia el lado seguro.
   El servidor solo exige CSRF. #}
<section class="adminZonaPeligro">
    <h2>Eliminar el tr&aacute;mite</h2>
    <p class="adminAyuda">
        Borra el tr&aacute;mite con todo su historial y sus enlaces de acceso: el cliente deja de poder verlo en el acto.
        No se puede deshacer.
    </p>
    <button type="button" class="adminBtn adminBtnPeligro" id="abrirEliminar">Eliminar tr&aacute;mite {{ tramite.referencia }}</button>
</section>

<dialog class="adminDialogo" id="dialogoEliminar" aria-labelledby="dialogoEliminarTitulo">
    <form method="post" action="{{ basePath }}/admin/tramites/{{ tramite.id }}/eliminar">
        <input type="hidden" name="_csrf" value="{{ csrf }}"/>
        <h2 id="dialogoEliminarTitulo">&iquest;Eliminar {{ tramite.referencia }}?</h2>
        <p><strong>{{ tramite.denominacion }}</strong></p>
        <p class="adminAyuda">
            Se borran el tr&aacute;mite, todo su historial y sus enlaces de acceso. El cliente deja de poder verlo.
            <strong>No se puede deshacer.</strong>
        </p>
        <div class="adminDialogoAcciones">
            {# Cancelar primero y con el foco: Enter por reflejo no borra nada. #}
            <button type="button" class="adminBtn adminBtnInverso" id="cancelarEliminar" autofocus>Cancelar</button>
            <button type="submit" class="adminBtn adminBtnPeligro">S&iacute;, eliminar</button>
        </div>
    </form>
</dialog>
<script>
    // Copiar enlace: el del aviso de recien emitido y los de la tabla. navigator.clipboard
    // solo existe en contexto seguro (https o localhost); afuera de eso se cae al
    // execCommand de siempre con un textarea temporal.
    (function () {
        function copiarConFallback(texto) {
            var area = document.createElement('textarea');
            area.value = texto;
            area.setAttribute('readonly', '');
            area.style.position = 'fixed';
            area.style.opacity = '0';
            document.body.appendChild(area);
            area.select();
            var ok = false;
            try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
            document.body.removeChild(area);
            return ok ? Promise.resolve() : Promise.reject();
        }

        function copiar(texto) {
            if (navigator.clipboard && window.isSecureContext) {
                return navigator.clipboard.writeText(texto).catch(function () { return copiarConFallback(texto); });
            }
            return copiarConFallback(texto);
        }

        document.addEventListener('click', function (e) {
            var boton = e.target.closest('[data-copiar]');
            if (!boton) { return; }
            var original = boton.dataset.textoOriginal || boton.textContent;
            boton.dataset.textoOriginal = original;
            copiar(boton.dataset.copiar).then(function () {
                boton.textContent = 'Copiado';
            }, function () {
                boton.textContent = 'No se pudo copiar';
            }).then(function () {
                setTimeout(function () { boton.textContent = original; }, 2000);
            });
        });
    })();

    // Volver a una etapa anterior se le muestra al cliente: se confirma. Saltear hacia
    // adelante no, es lo normal. Con la actual fuera del flujo (-1) no hay "anterior".
    (function () {
        var form = document.querySelector('[data-confirmar-retroceso]');
        if (!form) { return; }
        form.addEventListener('submit', function (e) {
            var actual = parseInt(form.dataset.posicionActual, 10);
            var opcion = form.elements.etapa.options[form.elements.etapa.selectedIndex];
            if (actual < 0 || !opcion || parseInt(opcion.dataset.posicion, 10) >= actual) { return; }
            if (!confirm('Vas a volver el trámite a «' + opcion.text.trim() + '». El cliente lo va a ver en su seguimiento. ¿Seguir?')) {
                e.preventDefault();
            }
        });
    })();

    (function () {
        var dialogo = document.getElementById('dialogoEliminar');
        document.getElementById('abrirEliminar').addEventListener('click', function () { dialogo.showModal(); });
        document.getElementById('cancelarEliminar').addEventListener('click', function () { dialogo.close(); });
        // Click en el fondo (fuera de la caja) cierra, como cualquier modal.
        dialogo.addEventListener('click', function (e) { if (e.target === dialogo) { dialogo.close(); } });
    })();
</script>
{% endblock %}
