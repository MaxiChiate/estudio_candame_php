{% extends 'layout/base.html.twig' %}
{% block content %}
<main>
<section class="sectionPage surface centered seguimientoPage">
    <div class="sectionHead">
        <p class="eyebrow">Seguimiento de tr&aacute;mite</p>
        <h1>{{ tramite.denominacion }}</h1>
        <p class="lede">Tr&aacute;mite <strong>{{ tramite.codigo }}</strong>.</p>
    </div>

    {# Lo unico de la pagina que le pide algo al cliente: va primero y nunca colapsado. #}
    {% if accionActual %}
        <div class="seguimientoAccion" role="note">
            <p class="seguimientoAccionTitulo">{{ etapaActualLabel }}</p>
            <p>{{ accionActual }}</p>
        </div>
    {% endif %}

    {% if tramite.observado %}
        <div class="seguimientoAviso" role="status">
            <p class="seguimientoAvisoTitulo">El tr&aacute;mite tiene una observaci&oacute;n pendiente</p>
            {% if tramite.notaObservacion %}
                <p>{{ tramite.notaObservacion }}</p>
            {% endif %}
            <p class="seguimientoAvisoPie">Contin&uacute;a en la etapa de {{ etapaActualLabel }}. Nos comunicamos con usted para resolverla.</p>
        </div>
    {% endif %}

    {# Linea vertical. Una etapa figura cumplida si el tramite paso por ahi, aunque
       despues haya vuelto atras: la vista es un loop y se puede correr mas de una. #}
    <ol class="seguimientoLinea">
        {% for etapa in linea %}
            <li class="seguimientoEtapa is-{{ etapa.estado }}"{% if etapa.estado == 'actual' %} aria-current="step"{% endif %}>
                <span class="seguimientoMarca" aria-hidden="true"></span>
                <div class="seguimientoEtapaCuerpo">
                    {% set marca %}{%- if etapa.repeticion %} <span class="seguimientoEtapaRepeticion">{{ etapa.repeticion }}</span>{% endif %}{% endset %}
                    {# Una salteada no lleva linea de estado: el punto pintado ya dice que
                       quedo atras, y no hay fecha que mostrar porque nunca pasó por ahí. #}
                    {% set meta %}
                        {%- if etapa.estado == 'cumplida' -%}
                            Cumplida{% if etapa.fecha %} el {{ etapa.fecha|date('d/m/Y') }}{% endif %}
                        {%- elseif etapa.estado == 'actual' -%}
                            Etapa actual{% if etapa.fecha %} desde el {{ etapa.fecha|date('d/m/Y') }}{% endif %}
                        {%- elseif etapa.estado == 'pendiente' -%}
                            Pendiente
                        {%- endif -%}
                    {% endset %}

                    {% if etapa.estado == 'actual' or not etapa.detalle %}
                        {# La etapa actual no se colapsa: es la respuesta a "como viene lo
                           mio" y, si se esconde, el cliente escribe igual. #}
                        <p class="seguimientoEtapaLabel">{{ etapa.label }}{{ marca }}</p>
                        {% if meta|trim %}<p class="seguimientoEtapaMeta">{{ meta }}</p>{% endif %}
                        {% if etapa.detalle %}<p class="seguimientoEtapaDetalle">{{ etapa.detalle }}</p>{% endif %}
                    {% else %}
                        {# Cumplidas y pendientes: el nombre abre la explicacion. #}
                        <details class="seguimientoEtapaQue">
                            <summary>
                                <span class="seguimientoEtapaLabel">
                                    {{- etapa.label }}{{ marca }}
                                    <span class="seguimientoEtapaQueMarca" aria-hidden="true">?</span>
                                </span>
                                {% if meta|trim %}<span class="seguimientoEtapaMeta">{{ meta }}</span>{% endif %}
                            </summary>
                            <p class="seguimientoEtapaDetalle">{{ etapa.detalle }}</p>
                        </details>
                    {% endif %}
                </div>
            </li>
        {% endfor %}
    </ol>

    {% if eventos is not empty %}
        <div class="seguimientoNotas">
            <h2>Novedades</h2>
            <ul>
                {% for evento in eventos %}
                    <li>
                        <p class="seguimientoNotaFecha">{{ evento.ocurridoEl|date('d/m/Y') }} &mdash; {{ etapasConfig[evento.etapa.value].label|default(evento.etapa.value) }}</p>
                        <p>{{ evento.notaPublica }}</p>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <p class="seguimientoPie">
        Esta p&aacute;gina informa el avance del tr&aacute;mite y se actualiza a medida que avanza.
        Ante cualquier duda puede <a class="inlineLink" href="{{ basePath }}/#contacto">escribirnos</a>.
    </p>
</section>
</main>
{% endblock %}
