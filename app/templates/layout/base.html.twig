<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{{ pageTitle|default('Estudio Candame') }}</title>
    {% if metaDescription is defined and metaDescription %}
        <meta name="description" content="{{ metaDescription }}"/>
    {% endif %}
    {% if metaKeywords is defined and metaKeywords %}
        <meta name="keywords" content="{{ metaKeywords }}"/>
    {% endif %}
    <meta name="robots" content="index,follow"/>
    <link rel="icon" href="{{ basePath }}/favicon.ico" sizes="any"/>
    <link rel="apple-touch-icon" href="{{ basePath }}/apple-touch-icon.png"/>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&amp;family=Karla:wght@300;400;500;600&amp;display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="{{ basePath }}/css/main.css"/>
</head>
<body>
<div class="mainContainer">
    {# Solo la aporta PageController (la home). En el resto de las paginas la variable
       ni siquiera esta definida, asi que esto no se renderiza. #}
    {% if barraSeguimiento is defined and barraSeguimiento %}
        <a class="barraSeguimiento" href="{{ basePath }}/seguimiento/{{ barraSeguimiento.token }}">
            <span class="barraSeguimientoTexto">
                Tr&aacute;mite <strong>{{ barraSeguimiento.referencia }}</strong> &mdash; {{ barraSeguimiento.etapaLabel }}
                {%- if barraSeguimiento.observado %} <span class="barraSeguimientoChip">observado</span>{% endif %}
            </span>
            <span class="barraSeguimientoCta">Ver estado &rarr;</span>
        </a>
    {% endif %}
    {% include 'layout/header.html.twig' %}
    {% block content %}{% endblock %}
    {% include 'layout/footer.html.twig' %}
</div>
<script src="{{ basePath }}/js/envio-form.js"></script>
<script src="{{ basePath }}/js/main.js"></script>
<script>
    (function (i, s, o, g, r, a, m) {
        i['GoogleAnalyticsObject'] = r;
        i[r] = i[r] || function () {
            (i[r].q = i[r].q || []).push(arguments)
        }, i[r].l = 1 * new Date();
        a = s.createElement(o), m = s.getElementsByTagName(o)[0];
        a.async = 1;
        a.src = g;
        m.parentNode.insertBefore(a, m)
    })(window, document, 'script', '//www.google-analytics.com/analytics.js', 'ga');

    ga('create', 'UA-50456103-1', 'estudiocandame.com.ar');
    ga('send', 'pageview');
</script>
</body>
</html>
