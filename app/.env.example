# Copiar a app/.env y completar. En el hosting, este archivo se sube por FTP
# directamente a /home/estudicn/app/.env (nunca se commitea).

APP_DEBUG=false
# Dejar vacio salvo que el proyecto se sirva desde un subdirectorio (ej. /web).
APP_BASE_PATH=

# --- SMTP (formulario de contacto) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
CONTACT_TO_ADDRESS=estudiocandame@gmail.com

# --- Configurador (tramites) ---
# Mientras este en false, /tramites/constitucion devuelve 404.
CONFIGURADOR_ENABLED=false

SAS_CAPITAL_MULTIPLO_SMVM=2
# Serie oficial "Salario minimo, vital y movil" (mensual, pesos corrientes)
# publicada por la Secretaria de Trabajo, Empleo y Seguridad Social en datos.gob.ar.
SAS_SMVM_API_URL="https://apis.datos.gob.ar/series/api/series/?ids=57.1_SMVMM_0_M_34&last=1&format=json"
# Respaldo si la API no responde. Actualizar a mano cuando cambie el SMVM.
SMVM_FALLBACK_VALOR=376600
SMVM_FALLBACK_FECHA=2026-08-01

CONSULTA_CONSTITUCION_TO_ADDRESS=info@estudiocandame.com.ar
CONSULTA_CONSTITUCION_RATE_LIMIT_VENTANA_SEGUNDOS=3600
CONSULTA_CONSTITUCION_RATE_LIMIT_MAX_ENVIOS=5

# Ruta de humo /tramites/constitucion/_humo -- dispara un envio de prueba real por SMTP
# desde produccion, para verificar que el hosting deja salir el mail. Si CUALQUIERA de
# las dos queda vacia, la ruta no se registra (404). No completar con valores reales en
# ningun .env commiteado.
SMOKE_TEST_TO=
SMOKE_TEST_TOKEN=

# --- Portal de seguimiento de tramites ---
# Mientras este en false, /seguimiento y /admin/tramites no se registran (404) y no se
# abre ninguna conexion a la base.
SEGUIMIENTO_ENABLED=false

# Base de datos (MySQL/MariaDB). Requerida solo si SEGUIMIENTO_ENABLED=true.
# El esquema se aplica A MANO: database/migrations/001_seguimiento.sql
# (en prod, pegandolo en phpMyAdmin desde cPanel).
# Si la password trae caracteres especiales, ponerla entre comillas SIMPLES.
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# Panel de la doctora (/admin/tramites), protegido con HTTP Basic.
# ADMIN_PASS_HASH se genera con:
#   php -r 'echo password_hash("la-password", PASSWORD_DEFAULT), PHP_EOL;'
# y va SIEMPRE entre comillas simples: bcrypt arranca con "$2y$" y sin comillas el
# parser del .env expande esos "$" como variables y rompe el hash.
ADMIN_USER=
ADMIN_PASS_HASH=''

# Origen del sitio, para armar el link completo del token al emitirlo en el panel.
# Sin barra final. En local suele ser http://localhost:8000
APP_URL=https://estudiocandame.com.ar
