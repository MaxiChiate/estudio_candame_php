# Copiar a app/.env y completar. En el hosting, este archivo se sube por FTP
# directamente a /home/estudicn/app/.env (nunca se commitea).

APP_DEBUG=false
# Dejar vacio salvo que el proyecto se sirva desde un subdirectorio (ej. /web).
APP_BASE_PATH=

# --- SMTP (formulario de contacto) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
CONTACT_TO_ADDRESS=estudiocandame@gmail.com

# --- Configurador (tramites) ---
# Mientras este en false, /tramites/constitucion devuelve 404.
CONFIGURADOR_ENABLED=false

SAS_CAPITAL_MULTIPLO_SMVM=2
# Serie oficial "Salario minimo, vital y movil" (mensual, pesos corrientes)
# publicada por la Secretaria de Trabajo, Empleo y Seguridad Social en datos.gob.ar.
SAS_SMVM_API_URL="https://apis.datos.gob.ar/series/api/series/?ids=57.1_SMVMM_0_M_34&last=1&format=json"
# Respaldo si la API no responde. Actualizar a mano cuando cambie el SMVM.
SMVM_FALLBACK_VALOR=376600
SMVM_FALLBACK_FECHA=2026-08-01
