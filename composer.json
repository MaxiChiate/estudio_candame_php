{
    "name": "estudiocandame/web",
    "description": "Sitio de Estudio Candame - PHP para hosting compartido (cPanel)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "phpmailer/phpmailer": "^6.9",
        "phpoffice/phpspreadsheet": "^2.3",
        "phpoffice/phpword": "^1.3",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.10",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "EstudioCandame\\": "app/src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "vendor-dir": "app/vendor"
    }
}
